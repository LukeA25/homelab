# Study Desk Ask (OpenAI-compatible). Copy to .env and fill in.
# ChatGPT Plus does NOT include API access — use https://platform.openai.com

ASK_PROVIDER=openai
ASK_MODEL=gpt-5.6-sol
ASK_REASONING_EFFORT=medium
ASK_TIMEOUT_SECONDS=180
ASK_MAX_TOKENS=8000
OPENAI_API_KEY=
# Optional: point at Gemini/Groq/OpenRouter OpenAI-compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
