# Homelab voice assistant — copy to .env and fill in secrets.

OPENAI_API_KEY=sk-replace-me
ASSISTANT_DEVICE_TOKEN=dev-token-change-me

# Same Home Assistant token as compose/dashboard/.env
HA_BASE_URL=http://100.101.135.109:8123
HA_TOKEN=replace_with_ha_long_lived_token

HOMEWORK_BASE_URL=http://100.101.135.109:8005
DASHBOARD_BASE_URL=http://100.101.135.109:8004
DISPLAY_TZ=America/Chicago

# Models (optional overrides)
ASSISTANT_STT_MODEL=whisper-1
ASSISTANT_LLM_MODEL=gpt-5.4
ASSISTANT_LLM_REASONING=medium
ASSISTANT_TTS_MODEL=gpt-4o-mini-tts
ASSISTANT_TTS_VOICE=alloy

# Quiet hours for Pi wake-word client (local hour, DISPLAY_TZ)
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# Optional — only needed for confirm-gated Cursor edits
# CURSOR_API_KEY=
# CURSOR_REPO_PATH=/home/landerson/homelab
