# Nova gateway — copy to .env and fill in secrets. Generate tokens with: openssl rand -hex 32

OPENAI_API_KEY=sk-replace-me

# Old shared device token. Imported once as device "legacy-shared" with full access so
# existing clients keep working; revoke it after enrolling per-device credentials:
#   docker exec assistant python -m app.devices enroll iphone --scopes '*'
#   docker exec assistant python -m app.devices revoke legacy-shared
# The public default value is refused unless ALLOW_DEFAULT_LEGACY_TOKEN=true.
ASSISTANT_DEVICE_TOKEN=
# ALLOW_DEFAULT_LEGACY_TOKEN=false

# Same Home Assistant token as compose/dashboard/.env
HA_BASE_URL=http://100.101.135.109:8123
HA_TOKEN=replace_with_ha_long_lived_token

HOMEWORK_BASE_URL=http://100.101.135.109:8005
DASHBOARD_BASE_URL=http://100.101.135.109:8004
DISPLAY_TZ=America/Chicago

# Must match compose/agent-worker/.env
WORKER_TOKEN=replace-me
# WORKER_QUERY_TIMEOUT=40
# Must match compose/ops-runner/.env
OPS_GATEWAY_TOKEN=replace-me
# APPROVAL_TTL_SECONDS=120

# Models (optional overrides)
ASSISTANT_STT_MODEL=whisper-1
ASSISTANT_LLM_MODEL=gpt-5.4
ASSISTANT_LLM_REASONING=medium
ASSISTANT_TTS_MODEL=gpt-4o-mini-tts
ASSISTANT_TTS_VOICE=alloy

# Quiet hours for Pi wake-word client (local hour, DISPLAY_TZ)
QUIET_HOURS_START=23
QUIET_HOURS_END=7
