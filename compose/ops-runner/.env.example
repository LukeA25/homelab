# Copy to .env. Generate tokens with: openssl rand -hex 32
# Worker token: inspect any stack; up/rebuild/restart routine stacks; request protected ones.
OPS_WORKER_TOKEN=replace-me
# Gateway token: execute protected requests after the user approves. Only the assistant has it.
OPS_GATEWAY_TOKEN=replace-me
# Stacks the agent may operate without approval (everything else is protected):
# ROUTINE_STACKS=finance-app,guitar-app,theology-app,homework-app,learning-app,jellyfin,uptime-kuma,notify
# MANUAL_ONLY_STACKS=ops-runner,agent-worker
DISPLAY_TZ=America/Chicago
