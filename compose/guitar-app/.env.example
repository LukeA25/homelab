# Apple Music API (catalog search — no user login required)
# https://developer.apple.com/documentation/applemusicapi/generating-developer-tokens
#
# 1. Apple Developer → Certificates, Identifiers & Profiles
# 2. Create a Media ID with MusicKit enabled
# 3. Create a MusicKit private key (.p8), note Key ID + Team ID
# 4. Either paste the PEM below OR mount the .p8 and set APPLE_MUSIC_PRIVATE_KEY_PATH

APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_STOREFRONT=us

# Option A: inline PEM (escape newlines as \n)
# APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Option B: file on the data volume
# APPLE_MUSIC_PRIVATE_KEY_PATH=/data/AuthKey_XXXXXXXX.p8
