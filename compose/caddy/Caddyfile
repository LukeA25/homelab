{
	# QUIC/HTTP3 often hangs over Tailscale; stick to TCP.
	servers {
		protocols h1 h2
	}

	# Chrome mishandles Caddy's default 12h leaf + 7d intermediate.
	# Longer internal certs avoid the "spins forever" TLS bug.
	pki {
		ca local {
			intermediate_lifetime 365d
		}
	}
}

(local_https) {
	tls {
		issuer internal {
			lifetime 30d
		}
	}
}

# The iPhone has to trust this before https://*.home.arpa will load.
(local_ca) {
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=caddy-root.crt"
		file_server
	}
}

# Per-device sign-in (nova-auth). {args[0]} is the app name; the device needs
# scope app.<name>. Browsers sign in once at auth.home.arpa; scripts send
# "Authorization: Bearer <credential>". The web manifest is exempt because
# browsers fetch it without cookies.
(gate) {
	handle /__auth/* {
		reverse_proxy nova-auth:8000
	}
	@gated not path /__auth/* /manifest.webmanifest
	forward_auth @gated nova-auth:8000 {
		uri /verify?app={args[0]}
		copy_headers X-Nova-Device
	}
}

# Plain-HTTP app hosts only redirect: sign-in cookies are HTTPS-only.
(to_https) {
	import local_ca
	handle {
		redir https://{host}{uri}
	}
}

# Cast API + phone script live on the dashboard; every app host forwards them
# so the phone's cast requests stay same-origin.
(cast) {
	handle /__cast/* {
		reverse_proxy dashboard:8000
	}
}

# Phone notifications. Forwarded onto each app so a subscription belongs to
# that app. Sending is not exposed through this path.
(notify) {
	handle /__notify/* {
		reverse_proxy notify:8000
	}
	handle /manifest.webmanifest {
		reverse_proxy notify:8000
	}
}

# Dashboard (+ control/tv) behind assistant.home.arpa — reuses the cert
# that already works in browsers where homepage.home.arpa HTTPS hangs.
# Nova's own routes are not gated here: the gateway checks device credentials itself.
(assistant_host) {
	handle /__auth/* {
		reverse_proxy nova-auth:8000
	}

	@home_gated path /control /control/* /tv /tv/* /__cast/* /api/rooms /api/rooms/* /api/config /api/weather /api/finance /api/finance/* /api/homework /api/services /api/system /api/liturgy /api/tv-display /api/last-turn /api/last-turn/*
	forward_auth @home_gated nova-auth:8000 {
		uri /verify?app=home
		copy_headers X-Nova-Device
	}

	@dash_pages path /control /control/* /tv /tv/* /__cast/* /brand/nova-*
	handle @dash_pages {
		reverse_proxy dashboard:8000
	}

	@dash_api path /api/rooms /api/rooms/* /api/config /api/weather /api/finance /api/finance/* /api/homework /api/services /api/system /api/liturgy /api/tv-display
	handle @dash_api {
		reverse_proxy dashboard:8000
	}

	# Vite hashed bundles; assistant static is app.js / style.css
	@dash_assets path_regexp dash_assets ^/assets/(index|night|orbitron-latin|chakra-petch-latin|ibm-plex-mono-latin|barlow-latin)-
	handle @dash_assets {
		reverse_proxy dashboard:8000
	}

	import notify

	handle {
		reverse_proxy assistant:8000
	}
}

