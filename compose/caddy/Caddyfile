{
	# QUIC/HTTP3 often hangs over Tailscale; stick to TCP.
	servers {
		protocols h1 h2
	}

	# Chrome mishandles Caddy's default 12h leaf + 7d intermediate.
	# Longer internal certs avoid the "spins forever" TLS bug.
	pki {
		ca local {
			intermediate_lifetime 365d
		}
	}
}

(local_https) {
	tls {
		issuer internal {
			lifetime 30d
		}
	}
}

# The iPhone has to trust this before https://*.home.arpa will load.
(local_ca) {
	handle /caddy-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=caddy-root.crt"
		file_server
	}
}

# Cast API + phone script live on the dashboard; every app host forwards them
# so the phone's cast requests stay same-origin.
(cast) {
	handle /__cast/* {
		reverse_proxy 100.101.135.109:8004
	}
}

# Phone notifications. Forwarded onto each app so a subscription belongs to
# that app. Sending stays on :8008 and is not exposed through this path.
(notify) {
	handle /__notify/* {
		reverse_proxy 100.101.135.109:8008
	}
	handle /manifest.webmanifest {
		reverse_proxy 100.101.135.109:8008
	}
}

# Dashboard (+ control/tv) behind assistant.home.arpa — reuses the cert
# that already works in browsers where homepage.home.arpa HTTPS hangs.
(assistant_host) {
	@dash_pages path /control /control/* /tv /tv/* /__cast/*
	handle @dash_pages {
		reverse_proxy 100.101.135.109:8004
	}

	@dash_api path /api/rooms /api/rooms/* /api/config /api/weather /api/finance /api/finance/* /api/homework /api/services /api/system /api/liturgy /api/tv-display
	handle @dash_api {
		reverse_proxy 100.101.135.109:8004
	}

	# Vite hashed bundles; assistant static is app.js / style.css
	@dash_assets path_regexp dash_assets ^/assets/(index|night)-
	handle @dash_assets {
		reverse_proxy 100.101.135.109:8004
	}

	import notify

	handle {
		reverse_proxy 100.101.135.109:8006
	}
}

