#!/usr/bin/env python3
"""Container operations for the coding agent, via ops-runner.

  homelab-ops stacks
  homelab-ops ps <stack>
  homelab-ops logs <stack> [--tail N]
  homelab-ops up|rebuild|restart <stack> --reason "why"
  homelab-ops request <request-id>

Protected stacks return approval_required (exit code 2) with a request id.
The user approves it through Nova; this tool cannot.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

URL = os.getenv("OPS_URL", "http://ops-runner:8000").rstrip("/")
TOKEN = os.getenv("OPS_WORKER_TOKEN", "")


def call(method, path, body=None, timeout=960):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"{URL}{path}", data=data, method=method)
    req.add_header("Authorization", f"Bearer {TOKEN}")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as err:
        try:
            return err.code, json.loads(err.read() or b"{}")
        except ValueError:
            return err.code, {"detail": err.reason}
    except urllib.error.URLError as err:
        return 0, {"detail": f"ops-runner unreachable: {err.reason}"}


def main():
    parser = argparse.ArgumentParser(prog="homelab-ops")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("stacks")
    p = sub.add_parser("ps")
    p.add_argument("stack")
    p = sub.add_parser("logs")
    p.add_argument("stack")
    p.add_argument("--tail", type=int, default=200)
    for op in ("up", "rebuild", "restart"):
        p = sub.add_parser(op)
        p.add_argument("stack")
        p.add_argument("--reason", required=True)
    p = sub.add_parser("request")
    p.add_argument("request_id")
    args = parser.parse_args()

    if args.cmd == "stacks":
        status, data = call("GET", "/stacks")
    elif args.cmd == "ps":
        status, data = call("GET", f"/stacks/{urllib.parse.quote(args.stack)}/ps")
    elif args.cmd == "logs":
        status, data = call("GET", f"/stacks/{urllib.parse.quote(args.stack)}/logs?tail={args.tail}")
    elif args.cmd == "request":
        status, data = call("GET", f"/requests/{urllib.parse.quote(args.request_id)}")
    else:
        status, data = call("POST", f"/stacks/{urllib.parse.quote(args.stack)}/{args.cmd}", {"reason": args.reason})

    print(json.dumps(data, indent=2))
    if data.get("status") == "approval_required":
        sys.exit(2)
    sys.exit(0 if 200 <= status < 300 else 1)


if __name__ == "__main__":
    main()
