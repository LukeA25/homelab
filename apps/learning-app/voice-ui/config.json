{
  "visualTools": [
    {
      "type": "function",
      "name": "show_visual",
      "description": "Open or replace the whiteboard while continuing the spoken lesson. Use text for a short note, equation for LaTeX, plot for a calculated function or numeric series, chart for bars, diagram for labeled nodes with arrows, neural for a network you specify, or clear to return to the voice orb. Repeat with a revised specification to update a visual. Draw only the values you supply.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "equation",
              "plot",
              "chart",
              "diagram",
              "neural",
              "clear"
            ]
          },
          "title": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "equation": {
            "type": "string",
            "description": "Optional LaTeX equation displayed below any visual, or as the main visual."
          },
          "function": {
            "type": "string",
            "enum": [
              "relu",
              "sigmoid",
              "linear",
              "quadratic",
              "sin"
            ]
          },
          "a": {
            "type": "number",
            "description": "Function scale, default 1"
          },
          "b": {
            "type": "number",
            "description": "Vertical offset, default 0"
          },
          "xMin": {
            "type": "number"
          },
          "xMax": {
            "type": "number"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "label",
                "points"
              ],
              "additionalProperties": false
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Node IDs to emphasize"
          },
          "layers": {
            "type": "array",
            "description": "Neural layers from inputs to output. Use 2\u20134 layers and 1\u20136 nodes each.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nodes"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "activation": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "relu",
                    "sigmoid"
                  ]
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "number"
                      },
                      "bias": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "connections": {
            "type": "array",
            "description": "Arrows between neural node ids. Include weight only when that number should be shown and used. Omit this to draw every node connected to the next layer.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                }
              }
            }
          },
          "slider": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node"
            ],
            "description": "One slider bound to a node, usually an input.",
            "properties": {
              "node": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    {
      "type": "function",
      "name": "update_visual",
      "description": "Change the neural diagram already on screen. Set the slider, highlight node ids, or animate the arrows. Omit fields you are not changing.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slider": {
            "type": "number"
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "animate": {
            "type": "boolean"
          }
        }
      }
    }
  ],
  "teachingInstructions": "You are Grove, a friendly voice tutor. Follow the saved lesson context and any saved learner preferences. The screen begins with only a voice orb. Keep conversation natural and responsive, vary sentence length, and ask one question at a time only when it helps. Avoid canned praise. Speak the explanation. A visual should match what you are saying; do not force one, and do not open a neural diagram unless the current concept is about a network. Call show_visual for text, a LaTeX equation, a calculated plot, a bar chart, a labeled diagram with arrows, a neural diagram, or clear. For a neural diagram, supply the layers, how many nodes each layer has, and labels in the learner\u2019s terms. Add weights only when you want those numbers shown. Add one slider only when the learner should try a value. There is no built-in example network. Use update_visual to move that slider, highlight nodes, or animate arrows. Repeat show_visual to change the structure. The app draws the values you supply. Never invent a stock network or extra visual capabilities. Continue until the learner chooses to finish. Do not suggest stopping, wrapping up, or ending for the day. The learner can see the elapsed time. Use propose_recap for the structured recap. Never read JSON aloud and never say a recap was saved. For visual changes, delegate the request to the backend when using GPT-Live; then explain the result conversationally.",
  "defaultVoice": "cedar",
  "realtimeVoices": [
