# Copy to ~/.config/homelab/wake.env on the Pi (chmod 600). Do not commit secrets.

ASSISTANT_URL=https://assistant.home.arpa
ASSISTANT_DEVICE_TOKEN=replace-me
ASSISTANT_SESSION_ID=pi-wake
# Internal Caddy CA is not in the Pi trust store.
ASSISTANT_TLS_VERIFY=0

DISPLAY_TZ=America/Chicago
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# vosk (default, any English phrase) or openwakeword
WAKE_ENGINE=vosk
WAKE_WORD=hey homelab,hey home lab,hey home love
WAKE_SENSITIVITY=0.35
WAKE_GAIN=2.2
PREROLL_SECONDS=1.8
UTTERANCE_SECONDS=5
VOSK_MODEL=/home/homelab/vosk-model-small-en-us-0.15
